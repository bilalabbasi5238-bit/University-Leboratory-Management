rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to validate ID format
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Laboratories collection
    match /laboratories/{labId} {
      allow read: if true;
      allow write: if isValidId(labId);
    }

    // Equipment collection
    match /equipment/{equipmentId} {
      allow read: if true;
      allow write: if isValidId(equipmentId);
    }

    // Issue records (Circulation desk)
    match /issueRecords/{recordId} {
      allow read: if true;
      allow write: if isValidId(recordId);
    }

    // Students collection
    match /students/{studentId} {
      allow read: if true;
      allow write: if isValidId(studentId);
    }

    // Activity logs
    match /activityLogs/{logId} {
      allow read: if true;
      allow write: if isValidId(logId);
    }

    // Maintenance records
    match /maintenance/{maintenanceId} {
      allow read: if true;
      allow write: if isValidId(maintenanceId);
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
